# Configuración sensible de la aplicación FillRateRetail
# Copiar este archivo como .env y completar los valores reales.
# Nunca subir este archivo al repositorio.

# Llave de acceso del agente de IA local (puede quedar vacía en instalación local sin autenticación)
IA_API_KEY=

# Puerto de la aplicación local
APP_PORT=5000

# Dirección de acceso local
APP_HOST=127.0.0.1
